{
  "buildCommand": "npm run build",
  "outputDirectory": "vercel-public",
  "framework": null,
  "regions": ["fra1"],
  "rewrites": [
    {"source":"/(accueil|nouvelle-partie|partie|historique|joueurs|classements|bareme|groupes)","destination":"/index.html"},
    {"source":"/nouvelle-partie/table","destination":"/index.html"},
    {"source":"/(historique|joueurs|suivre)/:id","destination":"/index.html"}
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"Cache-Control","value":"no-store"}
    ]
  }]
}
